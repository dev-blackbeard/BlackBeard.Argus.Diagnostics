<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      v1 scope: Android and Windows only. iOS/MacCatalyst need a macOS build agent to compile at
      all, and this repository's CI matrix (ubuntu-latest, windows-latest; see ci.yml) has none.
      Recorded as a CLAUDE.md backlog item rather than silently limited; adding a TFM to an
      already-multi-targeted library later is a small change, not a rearchitecture.
    -->
    <!--
      net8.0-windows10.0.19041.0 cannot restore or build at all on a non-Windows OS (no Windows
      SDK reference assemblies), so it is only ever in the list when actually running on Windows,
      matching how the standard MAUI project templates handle this, and how this repository's own
      CI matrix (ubuntu-latest, windows-latest) needs it split.
    -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>

    <!--
      NETSDK1202 ("workload out of support"), suppressed rather than chased by TFM/SDK version:
      pinning the SDK to 8.0.x instead (an earlier attempt, since reverted) broke analyzer loading
      for every project in the repo: Microsoft.CodeAnalysis.PublicApiAnalyzers 4.14.0 needs a
      newer Roslyn than an 8.0.x SDK bundles. The workload being out of support means Android
      builds here stop receiving security updates, which is an acceptable, explicit trade-off for
      a control library's Android target, not a reason to force an older SDK repo-wide.

      This check is raised via an unconditional <Error> task in the SDK's own
      Microsoft.NET.EolTargetFrameworks.targets, not a normal compiler warning, so NoWarn alone
      cannot suppress it: CheckEolTargetFramework is the property that file itself gates the
      check on. NoWarn is kept too in case a related diagnostic does go through the warning path.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>

    <!--
      Without this, the WinUI XAML compiler (Microsoft.UI.Xaml.Markup.Compiler) treats this class
      library like an app and fails compiling EntityHealthCollectionView.xaml (MSB3073,
      XamlCompiler.exe exit code 1, no further detail surfaced in CI's log capture). Same property,
      same reasoning as ArgusMonitorDemo.csproj's own: that one is an actual app and needs it for
      a different reason (skipping MSIX Store packaging), but a class library needs it too, to
      avoid the packaging-oriented XAML compilation path entirely.
    -->
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
    <SingleProject>false</SingleProject>
    <RootNamespace>Argus.Controls.Maui</RootNamespace>
    <AssemblyName>Argus.Controls.Maui</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>BlackBeard.Argus.Controls.Maui</PackageId>
    <Description>A .NET MAUI CollectionView-based control that visualises IEntityStreamMonitor output: 6DOF, per-entity anomaly counts, severity colour and flash. Pair with BlackBeard.Argus.Controls (portable, no MAUI Controls dependency) for the underlying view-model.</Description>

    <!--
      Inherited InvariantGlobalization=true from Directory.Build.props does not suit a UI control
      library: MAUI/platform culture-aware formatting expects it off. Overridden here, scoped to
      this project only.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Windows-only TFM needs this even in a class library, same as an app project would set it. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Argus.Controls/Argus.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Architecture rule 3, as amended: this is the one and only project in the repository
      permitted to reference Microsoft.Maui.Controls. ArgusGuardUiDependencies in
      Directory.Build.targets enforces exactly that: every other project, Argus.Graphics and
      Argus.Controls included, fails the build the moment it references Microsoft.Maui.Controls
      or sets UseMaui.
    -->
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="EntityHealthCollectionView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
