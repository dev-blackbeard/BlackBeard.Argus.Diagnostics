<Project>

  <!--
    Architecture rule 2 — Argus.Core has zero dependency PackageReference entries.

    "Dependency" is the operative word. A PackageReference marked PrivateAssets="all"
    (an analyzer, a build task, a source generator) contributes nothing to the produced
    .nupkg's <dependencies> and therefore nothing to a consumer's restore graph. That is
    how Microsoft.CodeAnalysis.PublicApiAnalyzers (rule 8) coexists with rule 2.

    Implicit references added by the SDK itself (NETStandard.Library for netstandard2.0)
    are excluded for the same reason: they are framework plumbing, not a choice.

    Argus.Package.Tests re-checks the same invariant from the other side, by asserting
    the packed Argus.Core.nupkg declares no dependencies at all.
  -->
  <PropertyGroup>
    <ArgusForbidPackageDependencies Condition="'$(ArgusForbidPackageDependencies)' == ''">false</ArgusForbidPackageDependencies>
  </PropertyGroup>

  <Target Name="ArgusGuardNoPackageDependencies"
          Condition="'$(ArgusForbidPackageDependencies)' == 'true'"
          BeforeTargets="CollectPackageReferences;Build;Pack">
    <ItemGroup>
      <_ArgusOffendingPackageReference Include="@(PackageReference)"
                                       Condition="'%(PackageReference.IsImplicitlyDefined)' != 'true'
                                                  and '%(PackageReference.PrivateAssets)' != 'all'
                                                  and '%(PackageReference.ExcludeAssets)' != 'all'" />
    </ItemGroup>
    <Error Condition="'@(_ArgusOffendingPackageReference)' != ''"
           Code="ARGUS0001"
           Text="$(MSBuildProjectName) must have zero dependency PackageReference entries (architecture rule 2), but declares: @(_ArgusOffendingPackageReference, ', '). If this is an analyzer or build-only asset, add PrivateAssets=&quot;all&quot;. If it is a real dependency, it does not belong in this project." />
  </Target>

  <!--
    Guard against rule 3 being violated by accident, as amended for Argus.Controls.Maui:

      - Argus.Graphics / Argus.Graphics.Tests may reference Microsoft.Maui.Graphics, and nothing
        else under Microsoft.Maui.*.
      - Argus.Controls.Maui / Argus.Controls.Maui.Tests may reference Microsoft.Maui.Controls, and
        nothing else under Microsoft.Maui.*.
      - Every other project — Argus.Controls included — may reference no Microsoft.Maui.* package
        at all. Argus.Controls gets Color transitively through its ProjectReference to
        Argus.Graphics, which is not a PackageReference and so is invisible to this scan; that is
        by design, not a gap it needs an exemption for.

    Two projects, two disjoint allow-lists, checked below. Neither project's allow-list grants the
    other's package.
  -->
  <PropertyGroup>
    <_ArgusGraphicsOnlyProject Condition="'$(MSBuildProjectName)' == 'Argus.Graphics' or '$(MSBuildProjectName)' == 'Argus.Graphics.Tests'">true</_ArgusGraphicsOnlyProject>
    <_ArgusControlsMauiProject Condition="'$(MSBuildProjectName)' == 'Argus.Controls.Maui' or '$(MSBuildProjectName)' == 'Argus.Controls.Maui.Tests'">true</_ArgusControlsMauiProject>
  </PropertyGroup>

  <Target Name="ArgusGuardUiDependencies" BeforeTargets="CollectPackageReferences;Build">
    <ItemGroup>
      <_ArgusMauiReference Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('Microsoft.Maui'))" />
      <_ArgusForbiddenGraphicsReference Include="@(_ArgusMauiReference)" Condition="'$(_ArgusGraphicsOnlyProject)' == 'true' and '%(Identity)' != 'Microsoft.Maui.Graphics'" />
      <_ArgusForbiddenControlsMauiReference Include="@(_ArgusMauiReference)" Condition="'$(_ArgusControlsMauiProject)' == 'true' and '%(Identity)' != 'Microsoft.Maui.Controls'" />
    </ItemGroup>

    <Error Condition="'@(_ArgusMauiReference)' != '' and '$(_ArgusGraphicsOnlyProject)' != 'true' and '$(_ArgusControlsMauiProject)' != 'true'"
           Code="ARGUS0002"
           Text="$(MSBuildProjectName) references @(_ArgusMauiReference, ', '). Colour/label presentation lives only in Argus.Graphics, and the MAUI CollectionView control lives only in Argus.Controls.Maui (architecture rule 3)." />
    <Error Condition="'@(_ArgusForbiddenGraphicsReference)' != ''"
           Code="ARGUS0003"
           Text="$(MSBuildProjectName) references @(_ArgusForbiddenGraphicsReference, ', '). The only permitted MAUI dependency here is Microsoft.Maui.Graphics, the standalone netstandard2.0 package (architecture rule 3)." />
    <Error Condition="'@(_ArgusForbiddenControlsMauiReference)' != ''"
           Code="ARGUS0004"
           Text="$(MSBuildProjectName) references @(_ArgusForbiddenControlsMauiReference, ', '). The only permitted MAUI dependency here is Microsoft.Maui.Controls (architecture rule 3)." />

    <!--
      Belt-and-suspenders: UseMaui=true is how a MAUI class library actually pulls in
      Microsoft.Maui.Controls, and it is not certain that always shows up as an explicit
      PackageReference item the scan above would see (workload-provided framework references may
      not). Keyed on the property itself so the rule holds either way.
    -->
    <Error Condition="'$(UseMaui)' == 'true' and '$(_ArgusControlsMauiProject)' != 'true'"
           Code="ARGUS0005"
           Text="$(MSBuildProjectName) sets UseMaui=true. Only Argus.Controls.Maui may (architecture rule 3)." />
  </Target>

</Project>
