<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The local feed that scripts/pack-local writes into. samples/ and
      tests/Argus.Package.Tests restore the Argus packages from here.
    -->
    <add key="argus-local" value="./artifacts/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="argus-local">
      <package pattern="BlackBeard.Argus.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
